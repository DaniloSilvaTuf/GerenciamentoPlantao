@using GerenciamentoPlantao.Models.Escala
@model RegraRotacaoEscala

@{
    ViewData["Title"] = "Detalhes da Regra de Rotação";

    var horarios = ViewBag.Horarios as List<RegraRotacaoHorarioEscala>
                   ?? new List<RegraRotacaoHorarioEscala>();
}

<div class="container-fluid mt-4">

    <!-- CABEÇALHO -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>
            <i class="bi bi-arrow-repeat"></i>
            Detalhes da Regra de Rotação
        </h2>

        <a asp-area="Escalas"
           asp-controller="RegraRotacaoEscala"
           asp-action="Index"
           asp-route-departamentoId="@Model.DepartamentoId"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i>
            Voltar
        </a>

    </div>

    <!-- MENSAGENS -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle"></i>
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle"></i>
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- DADOS DA REGRA -->
    <div class="card mb-4 shadow-sm">

        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="bi bi-info-circle"></i>
                Informações da Regra
            </h5>
        </div>

        <div class="card-body">

            <dl class="row">

                <dt class="col-sm-3">Código</dt>
                <dd class="col-sm-9">@Model.Id</dd>

                <dt class="col-sm-3">Nome</dt>
                <dd class="col-sm-9">@Model.Nome</dd>

                <dt class="col-sm-3">Departamento</dt>
                <dd class="col-sm-9">@Model.Departamento?.Nome</dd>

                <dt class="col-sm-3">Ordem de Execução</dt>
                <dd class="col-sm-9">@Model.OrdemExecucao</dd>

            </dl>

            <div class="d-flex gap-2">

                <a asp-area="Escalas"
                   asp-controller="RegraRotacaoEscala"
                   asp-action="Edit"
                   asp-route-id="@Model.Id"
                   asp-route-departamentoId="@Model.DepartamentoId"
                   class="btn btn-warning">

                    <i class="bi bi-pencil-square"></i>
                    Editar Regra

                </a>

                <form asp-area="Escalas"
                      asp-controller="RegraRotacaoEscala"
                      asp-action="Delete"
                      method="post"
                      onsubmit="return confirm('Deseja realmente excluir esta regra e todos os horários vinculados?');">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@Model.Id" />

                    <input type="hidden"
                           name="departamentoId"
                           value="@Model.DepartamentoId" />

                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash"></i>
                        Excluir Regra
                    </button>

                </form>

            </div>

        </div>
    </div>

    <!-- HORÁRIOS DA ROTAÇÃO -->
    <div class="card shadow-sm">

        <div class="card-header d-flex justify-content-between align-items-center">

            <h5 class="mb-0">
                <i class="bi bi-clock-history"></i>
                Horários da Rotação
            </h5>

            <a asp-area="Escalas"
               asp-controller="RegraRotacaoHorarioEscala"
               asp-action="Create"
               asp-route-regraRotacaoId="@Model.Id"
               asp-route-departamentoId="@Model.DepartamentoId"
               class="btn btn-success btn-sm">

                <i class="bi bi-plus-circle"></i>
                Adicionar Horário

            </a>

        </div>

        <div class="card-body">

            <div class="mb-3">
                <span class="badge bg-primary">
                    @horarios.Count horário(s) cadastrado(s)
                </span>
            </div>

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>Ordem</th>
                            <th>Posto</th>
                            <th>Bloco</th>
                            <th>Dia da Semana</th>
                            <th>Hora Inicial</th>
                            <th>Hora Final</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (horarios.Any())
                        {
                            @foreach (var horario in horarios.OrderBy(h => h.OrdemRotacao))
                            {
                                var bloco = horario.BlocoHorarioEscala;

                                <tr>

                                    <!-- ORDEM -->
                                    <td>
                                        <span class="badge bg-secondary">
                                            @horario.OrdemRotacao
                                        </span>
                                    </td>

                                    <!-- POSTO -->
                                    <td>
                                        <strong>
                                            @bloco.PostoEscala.Nome
                                        </strong>
                                    </td>

                                    <!-- BLOCO -->
                                    <td>
                                        @bloco.Nome
                                    </td>

                                    <!-- DIA -->
                                    <td>
                                        @bloco.DiaSemana
                                    </td>

                                    <!-- HORA INICIAL -->
                                    <td>
                                        @bloco.HoraInicio.ToString("HH:mm")
                                    </td>

                                    <!-- HORA FINAL -->
                                    <td>
                                        @bloco.HoraFim.ToString("HH:mm")
                                    </td>

                                    <!-- AÇÕES -->
                                    <td class="text-end">

                                        <div class="d-flex justify-content-end gap-2">

                                            <a asp-area="Escalas"
                                               asp-controller="RegraRotacaoHorarioEscala"
                                               asp-action="Edit"
                                               asp-route-id="@horario.Id"
                                               asp-route-regraRotacaoId="@Model.Id"
                                               asp-route-departamentoId="@Model.DepartamentoId"
                                               class="btn btn-sm btn-warning">

                                                <i class="bi bi-pencil"></i>
                                                Editar

                                            </a>

                                            <form asp-area="Escalas"
                                                  asp-controller="RegraRotacaoHorarioEscala"
                                                  asp-action="Delete"
                                                  method="post"
                                                  onsubmit="return confirm('Deseja realmente excluir este horário da rotação?');">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@horario.Id" />

                                                <input type="hidden"
                                                       name="regraRotacaoId"
                                                       value="@Model.Id" />

                                                <input type="hidden"
                                                       name="departamentoId"
                                                       value="@Model.DepartamentoId" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-danger">

                                                    <i class="bi bi-trash"></i>
                                                    Excluir

                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7"
                                    class="text-center text-muted py-4">

                                    <i class="bi bi-calendar-x fs-4 d-block mb-2"></i>

                                    Nenhum horário cadastrado nesta regra.

                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>