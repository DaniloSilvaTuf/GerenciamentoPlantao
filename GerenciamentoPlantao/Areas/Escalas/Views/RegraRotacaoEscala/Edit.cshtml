@using GerenciamentoPlantao.Models.ViewModels.Editar
@model EditarRegraRotacaoEscalaViewModel

@{
    ViewData["Title"] = "Editar Regra de Rotação";
}

<div class="container mt-4">

    <div class="card">

        <div class="card-header">
            <h4 class="mb-0">Editar Regra de Rotação</h4>
        </div>

        <div class="card-body">

            <form asp-action="Edit" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <input asp-for="Id" type="hidden" />
                <input asp-for="DepartamentoId" type="hidden" />

                <div class="mb-3">

                    <label asp-for="Nome" class="form-label">
                        Nome da Regra
                    </label>

                    <input asp-for="Nome" class="form-control" />

                    <span asp-validation-for="Nome"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-3">

                    <label asp-for="OrdemExecucao" class="form-label">
                        Ordem de Execução
                    </label>

                    <input asp-for="OrdemExecucao"
                           type="number"
                           min="1"
                           class="form-control" />

                    <span asp-validation-for="OrdemExecucao"
                          class="text-danger">
                    </span>

                </div>

                <div class="d-flex justify-content-between">

                    <a asp-action="Details"
                       asp-route-id="@Model.Id"
                       asp-route-departamentoId="@Model.DepartamentoId"
                       class="btn btn-secondary">
                        Voltar
                    </a>

                    <button type="submit" class="btn btn-primary">
                        Salvar Alterações
                    </button>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}