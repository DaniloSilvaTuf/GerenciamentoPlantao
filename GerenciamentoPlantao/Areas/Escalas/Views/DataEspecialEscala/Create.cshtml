@using GerenciamentoPlantao.Models.ViewModels.Adicionar
@model DataEspecialEscalaFormViewModel

@{
    ViewData["Title"] = "Cadastrar Data Especial";
}

<div class="container mt-4">

    <div class="card shadow-sm">

        <div class="card-header bg-primary text-white">

            <h3 class="mb-0">
                <i class="bi bi-calendar-event"></i> Cadastrar Data Especial
            </h3>

        </div>

        <div class="card-body">

            <form asp-area="Escalas"
                  asp-controller="DataEspecialEscala"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>

                <!-- DESCRIÇÃO -->
                <div class="mb-3">

                    <label asp-for="Descricao"
                           class="form-label fw-bold">
                        Descrição
                    </label>

                    <input asp-for="Descricao"
                           class="form-control form-control-lg"
                           autocomplete="off"
                           placeholder="Ex.: Natal, Ano Novo, Aniversário da Cidade..." />

                    <span asp-validation-for="Descricao"
                          class="text-danger">
                    </span>

                </div>

                <!-- DEPARTAMENTO -->
                <div class="mb-3">

                    <label asp-for="DepartamentoId"
                           class="form-label fw-bold">
                        Departamento
                    </label>

                    <select asp-for="DepartamentoId"
                            asp-items="Model.Departamentos"
                            class="form-select">

                        <option value="">
                            Selecione um departamento
                        </option>

                    </select>

                    <span asp-validation-for="DepartamentoId"
                          class="text-danger">
                    </span>

                    <span class="form-text">
                        O departamento da data especial não poderá ser alterado posteriormente.
                    </span>

                </div>

                <!-- DATA ESPECIAL -->
                <div class="mb-3">

                    <label asp-for="Data"
                           class="form-label fw-bold">
                        Data Especial
                    </label>

                    <input asp-for="Data"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="Data"
                          class="text-danger">
                    </span>

                    <span class="form-text">
                        Informe a data que será considerada especial na geração das escalas.
                    </span>

                </div>

                <!-- BOTÕES -->
                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-floppy-fill"></i>
                        Salvar

                    </button>

                    <a asp-area="Escalas"
                       asp-controller="DataEspecialEscala"
                       asp-action="Index"
                       class="btn btn-outline-secondary">

                        <i class="bi bi-arrow-left"></i>
                        Voltar

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}