@model GerenciamentoPlantao.Models.ViewModels.Adicionar.UsuarioFormViewModel

@{
    ViewData["Title"] = "Cadastrar Usuário";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">
                <i class="bi bi-person-plus-fill"></i> Cadastrar Usuário
            </h3>
        </div>

        <div class="card-body">
            <form asp-action="Create">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>

                <div class="mb-3">
                    <label asp-for="DescNome" class="form-label fw-bold">
                        Nome
                    </label>

                    <input asp-for="DescNome"
                           class="form-control form-control-lg"
                           placeholder="Digite o nome completo" />

                    <span asp-validation-for="DescNome"
                          class="text-danger">
                    </span>
                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="NmUsuario"
                               class="form-label fw-bold">
                            Nome de Usuário
                        </label>

                        <input asp-for="NmUsuario"
                               class="form-control form-control-lg"
                               placeholder="Digite o nome de usuário"
                               autocomplete="off" />

                        <span class="form-text">
                            O nome de usuário não poderá ser alterado posteriormente.
                        </span>

                        <span asp-validation-for="NmUsuario"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="Perfil"
                               class="form-label fw-bold">
                            Perfil
                        </label>

                        <select asp-for="Perfil"
                                asp-items="Model.Perfis"
                                class="form-select">

                            <option value="">
                                Selecione...
                            </option>

                        </select>

                        <span asp-validation-for="Perfil"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="Senha"
                               class="form-label fw-bold">
                            Senha
                        </label>

                        <div class="input-group">

                            <input asp-for="Senha"
                                   class="form-control"
                                   id="senha" />

                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    data-toggle-password="senha">

                                <i class="bi bi-eye"></i>

                            </button>

                        </div>

                        <span asp-validation-for="Senha"
                              class="text-danger">
                        </span>

                        <div class="mt-2 small">

                            <div id="reqTamanho" class="text-danger">
                                <i class="bi bi-x-circle"></i>
                                Mínimo de 8 caracteres
                            </div>

                            <div id="reqMaiuscula" class="text-danger">
                                <i class="bi bi-x-circle"></i>
                                Uma letra maiúscula
                            </div>

                            <div id="reqMinuscula" class="text-danger">
                                <i class="bi bi-x-circle"></i>
                                Uma letra minúscula
                            </div>

                            <div id="reqNumero" class="text-danger">
                                <i class="bi bi-x-circle"></i>
                                Um número
                            </div>

                            <div id="reqEspecial" class="text-danger">
                                <i class="bi bi-x-circle"></i>
                                Um caractere especial
                            </div>

                        </div>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="ConfirmarSenha"
                               class="form-label fw-bold">
                            Confirmar Senha
                        </label>

                        <div class="input-group">

                            <input asp-for="ConfirmarSenha"
                                   class="form-control"
                                   id="confirmarSenha" />

                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    data-toggle-password="confirmarSenha">

                                <i class="bi bi-eye"></i>

                            </button>

                        </div>

                        <span asp-validation-for="ConfirmarSenha"
                              class="text-danger">
                        </span>

                        <div id="reqConfirmacao"
                             class="small text-danger mt-2">

                            <i class="bi bi-x-circle"></i>
                            As senhas ainda não coincidem

                        </div>

                    </div>

                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="DepartamentoId"
                               class="form-label fw-bold">
                            Departamento
                        </label>

                        <select asp-for="DepartamentoId"
                                asp-items="Model.Departamentos"
                                class="form-select">

                            <option value="">
                                Selecione um departamento
                            </option>

                        </select>

                        <span asp-validation-for="DepartamentoId"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="Email"
                               class="form-label fw-bold">
                            E-mail
                        </label>

                        <input asp-for="Email"
                               type="email"
                               class="form-control form-control-lg"
                               placeholder="Digite o e-mail" />

                        <span asp-validation-for="Email"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="Telefone"
                               class="form-label fw-bold">
                            Telefone
                        </label>

                        <input asp-for="Telefone"
                               class="form-control form-control-lg"
                               placeholder="(00) 00000-0000" />

                        <span asp-validation-for="Telefone"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <div class="mb-3">

                    <div class="form-check form-switch">

                        <input asp-for="Plantonista"
                               class="form-check-input" />

                        <label asp-for="Plantonista"
                               class="form-check-label fw-bold">
                            Usuário Plantonista
                        </label>

                    </div>

                </div>

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-floppy-fill"></i>
                        Salvar

                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">

                        <i class="bi bi-arrow-left"></i>
                        Voltar

                    </a>

                </div>

            </form>

        </div>

    </div>
</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        const senha = document.getElementById("senha");
        const confirmarSenha = document.getElementById("confirmarSenha");

        // MOSTRAR / OCULTAR SENHAS
        document.querySelectorAll("[data-toggle-password]")
            .forEach(botao => {

                botao.addEventListener("click", function() {

                    const inputId = this.getAttribute("data-toggle-password");
                    const input = document.getElementById(inputId);
                    const icone = this.querySelector("i");

                    if (input.type === "password") {

                        input.type = "text";

                        icone.classList.remove("bi-eye");
                        icone.classList.add("bi-eye-slash");

                    }
                    else {

                        input.type = "password";

                        icone.classList.remove("bi-eye-slash");
                        icone.classList.add("bi-eye");

                    }

                });

            });

        // ALTERA VISUAL DOS REQUISITOS
        function validarRequisito(id, valido) {

            const elemento = document.getElementById(id);
            const icone = elemento.querySelector("i");

            if (valido) {

                elemento.classList.remove("text-danger");
                elemento.classList.add("text-success");

                icone.classList.remove("bi-x-circle");
                icone.classList.add("bi-check-circle-fill");

            }
            else {

                elemento.classList.remove("text-success");
                elemento.classList.add("text-danger");

                icone.classList.remove("bi-check-circle-fill");
                icone.classList.add("bi-x-circle");

            }

        }

        // REQUISITOS DA SENHA
        senha.addEventListener("input", function() {

            const valor = senha.value;

            validarRequisito(
                "reqTamanho",
                valor.length >= 8
            );

            validarRequisito(
                "reqMaiuscula",
                /[A-Z]/.test(valor)
            );

            validarRequisito(
                "reqMinuscula",
                /[a-z]/.test(valor)
            );

            validarRequisito(
                "reqNumero",
                /[0-9]/.test(valor)
            );

            validarRequisito(
                "reqEspecial",
                /[^A-Za-z0-9]/.test(valor)
            );

            validarConfirmacao();

        });

        // CONFIRMAÇÃO
        confirmarSenha.addEventListener("input", validarConfirmacao);

        function validarConfirmacao() {

            const iguais =
                senha.value.length > 0 &&
                senha.value === confirmarSenha.value;

            const elemento = document.getElementById("reqConfirmacao");

            validarRequisito("reqConfirmacao", iguais);

            if (iguais) {

                elemento.childNodes[elemento.childNodes.length - 1].textContent =
                    " As senhas coincidem";

            }
            else {

                elemento.childNodes[elemento.childNodes.length - 1].textContent =
                    " As senhas ainda não coincidem";

            }

        }

        // NOME DE USUÁRIO
        document.getElementById("NmUsuario")
            .addEventListener("input", function() {

                this.value = this.value
                    .toLowerCase()
                    .replace(/\s/g, '');

            });

        // MÁSCARA DE TELEFONE
        document.getElementById("Telefone")
            .addEventListener("input", function() {

                let valor = this.value.replace(/\D/g, '');

                if (valor.length > 11)
                    valor = valor.substring(0, 11);

                if (valor.length > 6)
                    valor = valor.replace(
                        /^(\d{2})(\d{5})(\d{0,4}).*/,
                        '($1) $2-$3'
                    );

                else if (valor.length > 2)
                    valor = valor.replace(
                        /^(\d{2})(\d+)/,
                        '($1) $2'
                    );

                this.value = valor;

            });

    </script>
}