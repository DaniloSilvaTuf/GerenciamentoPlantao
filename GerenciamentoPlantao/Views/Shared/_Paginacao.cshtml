@model GerenciamentoPlantao.Models.ViewModels.PaginacaoViewModel

@if (Model.TotalItens > 0)
{
    <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">

        <small class="text-muted">
            Página @Model.PaginaAtual de @Model.TotalPaginas
            — @Model.TotalItens registro(s)
        </small>

        <nav aria-label="Paginação">

            <ul class="pagination mb-0">

                @{
                    var parametrosAnterior = new Dictionary<string, string?>(Model.ParametrosRota);
                    parametrosAnterior["paginaAtual"] = (Model.PaginaAtual - 1).ToString();

                    var parametrosProxima = new Dictionary<string, string?>(Model.ParametrosRota);
                    parametrosProxima["paginaAtual"] = (Model.PaginaAtual + 1).ToString();
                }

                <!-- ANTERIOR -->
                <li class="page-item @(!Model.TemPaginaAnterior ? "disabled" : "")">

                    <a class="page-link"
                       asp-action="@Model.Action"
                       asp-controller="@Model.Controller"
                       asp-all-route-data="parametrosAnterior">

                        <i class="bi bi-chevron-left"></i>
                        Anterior

                    </a>

                </li>

                @{
                    var inicio = Math.Max(1, Model.PaginaAtual - 2);
                    var fim = Math.Min(Model.TotalPaginas, Model.PaginaAtual + 2);
                }

                <!-- PÁGINAS -->
                @for (var pagina = inicio; pagina <= fim; pagina++)
                {
                    var parametros = new Dictionary<string, string?>(Model.ParametrosRota);

                    parametros["paginaAtual"] = pagina.ToString();

                    <li class="page-item @(pagina == Model.PaginaAtual ? "active" : "")">

                        <a class="page-link"
                           asp-action="@Model.Action"
                           asp-controller="@Model.Controller"
                           asp-all-route-data="parametros">

                            @pagina

                        </a>

                    </li>
                }

                <!-- PRÓXIMA -->
                <li class="page-item @(!Model.TemProximaPagina ? "disabled" : "")">

                    <a class="page-link"
                       asp-action="@Model.Action"
                       asp-controller="@Model.Controller"
                       asp-all-route-data="parametrosProxima">

                        Próxima
                        <i class="bi bi-chevron-right"></i>

                    </a>

                </li>

            </ul>

        </nav>

    </div>
}