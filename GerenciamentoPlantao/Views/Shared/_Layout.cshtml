<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Gerenciamento Plantão</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GerenciamentoPlantao.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
</head>

<body style="background: linear-gradient(135deg, #eef5ff, #dfefff);">

    <div class="d-flex">

        <!-- SIDEBAR -->
        <div class="bg-dark text-white p-3 shadow-lg"
             style="width:260px; min-height:100vh;">

            <h4 class="text-center fw-bold mb-4">
                <a asp-controller="Home"
                   asp-action="Index"
                   class="text-white text-decoration-none">

                    <i class="bi bi-hospital fs-4"></i><br />

                    Gerenciamento<br />
                    Plantão

                </a>
            </h4>

            <hr class="text-secondary" />

            <ul class="nav flex-column gap-1">

                <!-- Acionamentos -->
                <li class="nav-item">
                    <a class="nav-link text-white"
                       asp-controller="Acionamentos"
                       asp-action="Index">
                        <i class="bi bi-telephone"></i>
                        Acionamentos
                    </a>
                </li>

                <!-- Cadastros -->
                <li class="nav-item">

                    <a class="nav-link text-white d-flex justify-content-between align-items-center"
                       data-bs-toggle="collapse"
                       href="#menuCadastros"
                       role="button">

                        <span>
                            <i class="bi bi-folder"></i>
                            Cadastros
                        </span>

                        <i class="bi bi-chevron-down"></i>

                    </a>

                    <div class="collapse" id="menuCadastros">

                        <ul class="nav flex-column ms-3 mt-2">

                            <li class="nav-item">
                                <a class="nav-link text-white"
                                   asp-controller="Estabelecimentos"
                                   asp-action="Index">
                                    <i class="bi bi-building"></i>
                                    Estabelecimentos
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-white"
                                   asp-controller="Setores"
                                   asp-action="Index">
                                    <i class="bi bi-diagram-3"></i>
                                    Setores
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-white"
                                   asp-controller="Departamentos"
                                   asp-action="Index">
                                    <i class="bi bi-collection"></i>
                                    Departamentos
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-white"
                                   asp-controller="Canais"
                                   asp-action="Index">
                                    <i class="bi bi-chat-dots"></i>
                                    Canais de Atendimento
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-white"
                                   asp-controller="CategoriasAcionamento"
                                   asp-action="Index">
                                    <i class="bi bi-tags"></i>
                                    Categorias de Acionamento
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-white"
                                   asp-controller="Solucoes"
                                   asp-action="Index">
                                    <i class="bi bi-check2-circle"></i>
                                    Soluções
                                </a>
                            </li>

                        </ul>

                    </div>

                </li>

                <!-- Usuários -->
                <li class="nav-item">
                    <a class="nav-link text-white"
                       asp-controller="Usuarios"
                       asp-action="Index">
                        <i class="bi bi-people"></i>
                        Usuários
                    </a>
                </li>

            </ul>

        </div>

        <!-- CONTEÚDO -->
        <div class="flex-grow-1 d-flex flex-column">

            <!-- NAVBAR -->
            <nav class="navbar navbar-expand-lg bg-white shadow-sm border-bottom px-4 py-3">

                <div>

                    <h5 class="mb-0 fw-bold text-primary">
                        Dashboard
                    </h5>

                    <small class="text-muted">
                        Sistema de Gerenciamento de Acionamentos
                    </small>

                </div>

                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <div class="ms-auto d-flex align-items-center">

                        <div class="d-flex align-items-center me-4">

                            <i class="bi bi-person-circle fs-3 text-primary me-2"></i>

                            <div>

                                <div class="fw-semibold">
                                    @User.Identity.Name
                                </div>

                                <small class="text-muted">
                                    Plantonista
                                </small>

                            </div>

                        </div>

                        <form asp-controller="Conta"
                              asp-action="Logout"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-outline-danger">

                                <i class="bi bi-box-arrow-right"></i>
                                Sair

                            </button>

                        </form>

                    </div>
                }

            </nav>

            <!-- CONTEÚDO -->
            <div class="container-fluid px-4 py-4 flex-grow-1">

                <main role="main">

                    @RenderBody()

                </main>

            </div>

            <!-- FOOTER -->
            <footer class="bg-white border-top shadow-sm">

                <div class="container-fluid px-4 py-3 text-muted">

                    &copy; 2026 - Gerenciamento Plantão

                </div>

            </footer>

        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>